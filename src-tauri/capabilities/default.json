{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for all windows",
  "windows": [
    "main",
    "download_*"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "store:default",
    "autostart:default",
    "core:tray:default",
    "dialog:default"
  ]
}